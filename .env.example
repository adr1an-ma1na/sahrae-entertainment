# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Scale / operations ─────────────────────────────────────────────────────
# A YouTube-only API key. Without it, YouTube rides on the Firebase key, which
# means a restriction change made for one can break the other — editing that
# key's allow-list to unblock YouTube can equally remove Identity Toolkit and
# take sign-in down. Create a second key restricted to YouTube Data API v3.
VITE_YOUTUBE_API_KEY=

# Where uncaught errors are posted. Any endpoint accepting a JSON POST works —
# a Sentry-compatible URL, a Vercel function, or leave empty to keep errors
# on-device only (they are still logged and kept for the diagnostics view).
VITE_ERROR_ENDPOINT=
