{
  "name": "sahrae-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OAuth PKCE connections to music services, unified SahraeTrack library, tiered playback (hand-off + sanctioned embeds).",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node --env-file=.env backend/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types connector-check.mjs && cd backend && node core-check.mjs && node worker-check.mjs",
    "build": "tsc --noEmit && vite build",
    "build:pwa": "npm run build",
    "build:android": "npm run build && cap sync android",
    "android:add": "cap add android",
    "android:open": "cap open android",
    "android:apk": "cd android && gradlew.bat assembleRelease",
    "android:aab": "cd android && gradlew.bat bundleRelease",
    "deploy:backend": "cd backend && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
