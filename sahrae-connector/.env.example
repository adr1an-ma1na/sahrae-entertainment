# ── Frontend (Vite) ───────────────────────────────────────────────────────
# Public by design: a PKCE client has to send its client id to start the flow.
# Never put a *secret* in a VITE_ variable — it ends up in the browser bundle.
VITE_SPOTIFY_CLIENT_ID=
VITE_YOUTUBE_CLIENT_ID=

# Token exchange runs SAME-ORIGIN on Vercel, so leave this empty for web and
# PWA builds — requests go to /oauth/... and vercel.json rewrites them onto the
# serverless function.
#
# The ANDROID build must set it to the absolute deployment URL. Capacitor serves
# the app from https://localhost, so a relative path resolves to nothing:
#   VITE_CONNECTOR_BACKEND=https://your-app.vercel.app
VITE_CONNECTOR_BACKEND=

# Must match the redirect URI registered with each provider, character for
# character. Defaults to <origin>/connect/callback when unset.
VITE_CONNECTOR_REDIRECT=http://localhost:3000/connect/callback

# ── Server-side (never bundled) ───────────────────────────────────────────
# Set these in Vercel → Settings → Environment Variables, not in a committed
# file. They are read by api/oauth/[provider]/[action].js at request time.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
