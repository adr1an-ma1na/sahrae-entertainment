# ── Frontend (Vite) ───────────────────────────────────────────────────────
# Public by design: a PKCE client has to send its client id to start the flow.
# Never put a *secret* in a VITE_ variable — it ends up in the browser bundle.
VITE_SPOTIFY_CLIENT_ID=
VITE_YOUTUBE_CLIENT_ID=

# Where the token-exchange backend runs.
VITE_CONNECTOR_BACKEND=http://localhost:8787

# Must match the redirect URI registered with each provider, character for
# character. Defaults to <origin>/connect/callback when unset.
VITE_CONNECTOR_REDIRECT=http://localhost:5173/connect/callback

# ── Backend (never bundled) ───────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Comma-separated CORS allow-list for the backend.
ALLOWED_ORIGINS=http://localhost:5173,https://localhost
PORT=8787
